# Hinata — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# Required variables are marked [REQUIRED].
# Optional variables have sensible defaults.

# ── Application ─────────────────────────────────────────────────────────────

# Environment: development | production
APP_ENV=development

# Web Application Server
WEB_HOST=0.0.0.0
WEB_PORT=2027

# Allowed CORS origins (comma-separated).
# In production, set this to your actual domain(s).
# Wildcard (*) is intentionally NOT supported.
WEB_ORIGINS=http://localhost:2027,http://127.0.0.1:2027

# ── Security ─────────────────────────────────────────────────────────────────

# [REQUIRED for Phase 1+] JWT secret key — minimum 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_real_secret_here

# JWT expiry in minutes (default: 60 minutes access, 30 days refresh)
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Database ─────────────────────────────────────────────────────────────────

# SQLite (default — good for development and small deployments)
DATABASE_URL=sqlite:///data/hinata.db

# Supabase PostgreSQL (recommended for Render/production)
# In Supabase Dashboard: Connect → Session pooler (port 5432) or Transaction
# pooler (port 6543). Paste the complete URL and URL-encode special characters
# in the password. DATABASE_URL takes precedence when both are set.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
# Alternatively, set this directly:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# ── Telegram ─────────────────────────────────────────────────────────────────

# [REQUIRED for Telegram bot] Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Owner Telegram User ID (for admin commands)
# Get your ID by messaging @userinfobot on Telegram
OWNER_ID=0

# ── AI Providers ──────────────────────────────────────────────────────────────
# Only configure providers you actually use. Keys are optional — the system
# falls back to other configured providers automatically.

# Default AI provider: groq | opencode_zen | openai | gemini | openrouter | bytez
AI_PROVIDER=groq
ENABLE_AI_FALLBACK=True

# Groq (fast, free tier available — https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenCode Zen (https://opencode.ai)
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=opencode/deepseek-v4-flash-free

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Bytez
BYTEZ_API_KEY=

# ── Voice ────────────────────────────────────────────────────────────────────

# (Phase 9) Speech-to-text and text-to-speech
# WHISPER_API_KEY=   # Uses Groq Whisper by default (same key as GROQ_API_KEY)
# TTS_PROVIDER=      # elevenlabs | local | openai

# ── Android ──────────────────────────────────────────────────────────────────

# Backend URL that Android devices should connect to.
# This is configured in the app Settings on the device itself,
# NOT hardcoded. This env var is for documentation purposes only.
# ANDROID_API_URL=https://your-backend.com

# ── Android Signing (CI/CD only — NEVER commit these values) ─────────────────
# These must be set as secrets in your CI/CD pipeline (GitHub Actions, etc.)
# DO NOT add actual values here. Use environment secrets or a secrets manager.
# KEYSTORE_PATH=/path/to/your/hinata.jks
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Locale ───────────────────────────────────────────────────────────────────

# Default language: en | hi | hinglish
DEFAULT_LANGUAGE=hinglish

# Timezone (IANA format)
TIMEZONE=Asia/Kolkata

# ── Redis (Phase 10+ optional) ───────────────────────────────────────────────
# Required only for task scheduling and working memory caching.
# REDIS_URL=redis://localhost:6379/0
