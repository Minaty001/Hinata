# Hinata - Environment Configuration
# Copy to .env and fill in your values

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# AI Provider (groq, opencode_zen)
AI_PROVIDER=groq

# Groq API Key (from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenCode Zen API Configuration (https://opencode.ai/zen/v1)
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=opencode-zen-free
ENABLE_AI_FALLBACK=True

# Database URL (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///data/hinata.db

# Owner Telegram User ID (for admin commands)
OWNER_ID=your_telegram_user_id

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default Language (en, hi, hi-en)
DEFAULT_LANGUAGE=en

# Timezone
TIMEZONE=Asia/Kolkata
